{
  "name": "fintrack-backend",
  "version": "1.0.0",
  "description": "FinTrack REST API - Node.js + Express + PostgreSQL",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/config/migrate.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage --forceExit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/migrate.js"
    ],
    "coverageReporters": ["text", "lcov"]
  }
}
