# ---------------------------------------------------------------------------
# FinTrack - example environment file
# Copy to .env and fill in real values.  NEVER commit the real .env file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- PostgreSQL (consumed by the postgres container) -------------------------
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fintrack
POSTGRES_PORT=5432

# --- Backend database connection ---------------------------------------------
# Host is the docker-compose service name "postgres" (not localhost) because the
# backend container talks to postgres over the internal docker network.
DATABASE_URL=postgresql://fintrack:change_me_locally@postgres:5432/fintrack

# --- Auth ---------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=change_me_this_is_not_secure
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=info

# --- Frontend build-time variable --------------------------------------------
# Requests go through nginx on the same origin, so a relative path is correct.
VITE_API_URL=/api

# --- Production image coordinates (used by docker-compose.prod.yml) -----------
# Docker Hub:  REGISTRY=docker.io/<your-dockerhub-username>
# Amazon ECR:  REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
REGISTRY=docker.io/your-dockerhub-username
IMAGE_TAG=latest
